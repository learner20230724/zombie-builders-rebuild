{
  "name": "zombie-builders-rebuild",
  "version": "0.4.1",
  "private": true,
  "description": "建筑工大战僵尸 / Zombie Trailer Park — configurable JavaScript game with Canvas 2D and Web Audio.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/learner20230724/zombie-builders-rebuild.git"
  },
  "scripts": {
    "start": "node scripts/server.mjs",
    "build": "node scripts/check-distribution.cjs",
    "test": "node --test tests/*.test.cjs && node scripts/check-data.mjs && node scripts/test-transpiler.cjs && node scripts/test-economy.cjs && node scripts/test-combat.cjs",
    "test:browser": "node scripts/smoke.mjs",
    "test:journey": "node scripts/browser-journey.mjs",
    "config:check": "node scripts/check-config.cjs",
    "package": "node scripts/package-release.cjs",
    "desktop": "electron .",
    "test:desktop": "node scripts/test-desktop.cjs",
    "package:desktop": "node --max-old-space-size=4096 scripts/package-desktop.cjs"
  },
  "release": {
    "name": "zombie-builders"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "playwright": "1.64.1"
  },
  "main": "desktop/main.cjs"
}
